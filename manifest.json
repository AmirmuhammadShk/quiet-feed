{
  "manifest_version": 2,
  "name": "Quiet Feed – Keyword Blocker",
  "version": "1.0.0",
  "description": "Hide posts that match your keyword policies on X/Twitter, LinkedIn, and sites you configure.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/compat.js",
      "shared/defaults.js",
      "background/background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Quiet Feed",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/compat.js",
        "shared/defaults.js",
        "content/filter.js"
      ],
      "css": ["content/filter.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{6cd97839-3cee-45e1-b28b-7d9621241f89}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
